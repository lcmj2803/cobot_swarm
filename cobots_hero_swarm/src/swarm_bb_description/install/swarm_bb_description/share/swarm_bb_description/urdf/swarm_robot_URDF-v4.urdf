        <mu2>1.0</mu2>
    </gazebo>
    <!-- Control diferencial de un solo robot en Gazebo Classic / ROS 2. -->
    <gazebo>
        <plugin name="swarm_bb_diff_drive" filename="libgazebo_ros_diff_drive.so">
            <ros>
                <namespace>/swarm_bb_01</namespace>
            </ros>
            <update_rate>50</update_rate>
            <num_wheel_pairs>1</num_wheel_pairs>
            <left_joint>Revolución-13</left_joint>
            <right_joint>Revolución-12</right_joint>
            <!-- Dimensiones de las colisiones actuales, sin neumaticos adicionales. -->
            <wheel_separation>0.0855</wheel_separation>
            <wheel_diameter>0.0284</wheel_diameter>
            <!-- Valores iniciales de prueba; no son mediciones de los motores reales. -->
            <max_wheel_torque>0.02</max_wheel_torque>
            <max_wheel_acceleration>0.1</max_wheel_acceleration>
            <!-- 1: pose y velocidad del mundo simulado; 0: odometria por ruedas. -->
            <odometry_source>1</odometry_source>
            <publish_odom>true</publish_odom>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <!-- Primera prueba en Gazebo: evita duplicar TF del lanzamiento de RViz. -->
            <publish_odom_tf>false</publish_odom_tf>
            <publish_wheel_tf>false</publish_wheel_tf>
        </plugin>
    </gazebo>
</robot>