    </gazebo>
    <gazebo reference="Pololu-Wheel-32x7mm-v1-1_1__Pololu-Wheel-32x7mm-rim___-_________-1_1">
        <!--Coeficientes iniciales de friccion para pruebas; no medidos.-->
